{
  "expo": {
    "name": "Parakeet",
    "slug": "parakeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "parakeet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
